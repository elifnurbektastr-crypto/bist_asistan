# Bu dosyayı .env adıyla kopyalayın ve kendi anahtarlarınızı yazın.
# .env dosyası .gitignore içindedir, git'e girmez.

# TCMB EVDS makro verisi için (opsiyonel; yoksa makro özellikler atlanır)
# Ücretsiz anahtar: https://evds2.tcmb.gov.tr
EVDS_API_KEY=

# Supabase (opsiyonel; yoksa duyuru/geri bildirim yerel SQLite'ta tutulur)
# Panel: Project Settings -> API Keys. Kurulum SQL'i: supabase/kurulum.sql
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret anahtar SADECE yerel .env'de: veri yükler, duyuru yönetir. Buluta (Streamlit Secrets) KONMAZ.
SUPABASE_SECRET_KEY=

# Sadece Streamlit Cloud Secrets'ta "1" yapılır: uygulama veriyi Supabase'den indirir.
BIST_BULUT=
