# Bu dosyayı .env adıyla kopyalayın ve kendi anahtarlarınızı yazın.
# .env dosyası .gitignore içindedir, git'e girmez.

# LLM ajanı için (opsiyonel; yoksa Sohbet sekmesi devre dışı kalır)
ANTHROPIC_API_KEY=

# TCMB EVDS makro verisi için (opsiyonel; yoksa makro özellikler atlanır)
# Ücretsiz anahtar: https://evds2.tcmb.gov.tr
EVDS_API_KEY=
